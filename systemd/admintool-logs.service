[Unit]
Description=admintool: разбор журналов и реагирование
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/admintool
ExecStart=/opt/admintool/bin/admintool.sh --logs --respond
SuccessExitStatus=1 2
StandardOutput=append:/var/log/admintool/systemd.log
StandardError=append:/var/log/admintool/systemd.log
