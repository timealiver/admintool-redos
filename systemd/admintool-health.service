[Unit]
Description=admintool: мониторинг ресурсов и аудит безопасности
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/admintool
ExecStart=/opt/admintool/bin/admintool.sh --health --audit
SuccessExitStatus=1 2
StandardOutput=append:/var/log/admintool/systemd.log
StandardError=append:/var/log/admintool/systemd.log
